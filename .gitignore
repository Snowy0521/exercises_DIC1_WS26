# Whitelist: only the exercise folders (with a placeholder README) are public.
# Official problem sheets / solutions (PDF), Solution_DE.md, simulations, etc.
# always stay local.

# Ignore everything ...
/*
!/.gitignore
!/README.md

# ... except the exercise folders and their placeholder README.
!/exercise_*/
/exercise_*/*
!/exercise_*/README.md

# ... and the mock exam folder with its placeholder README.
!/mock_exam/
/mock_exam/*
!/mock_exam/README.md

