# Whitelist: only the exercise folders (with a placeholder README) are public.
# Official problem sheets / solutions (PDF), my Markdown sources, images,
# Solution_DE.md, simulations, etc. always stay local.

# Ignore everything ...
/*
!/.gitignore
!/README.md

# ... except the exercise folders and their placeholder README.
!/exercise_*/
/exercise_*/*
!/exercise_*/README.md

# ... and the mock exam folder with its placeholder README.
!/mock_exam/
/mock_exam/*
!/mock_exam/README.md

# ---------------------------------------------------------------------------
# Released solutions: right after each session (Wed 14:45) uncomment that week's
# line, then commit and push. Only the PDF is published (images are embedded).
# ---------------------------------------------------------------------------
 !/exercise_01/solution_01_summary_zhang.pdf

# !/exercise_02/solution_02_summary_zhang.pdf

